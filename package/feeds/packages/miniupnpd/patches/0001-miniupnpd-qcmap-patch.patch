+
+	syslog(LOG_INFO, "update_portmapping() be called, and no need implement in QCMAP iptcrdr");
+	return -1;
+}
+
+                   /* return an (malloc'ed) array of "external" port for which there is
+ * a port mapping. number is the size of the array */
