From 4512ea063cd5898cf7f41e59e883ea69c5d93cd4 Mon Sep 17 00:00:00 2001
From: Yinxin Sun <quic_yinxsun@quicinc.com>
Date: Fri, 29 Nov 2024 10:17:36 +0800
Subject: [PATCH] libnftnl: add support for TRIGGER

Add netlink messages for TRIGGER

Signed-off-by: Yinxin Sun <quic_yinxsun@quicinc.com>
---
 include/libnftnl/expr.h             |  12 ++
 include/linux/netfilter/nf_tables.h |  32 ++++
 src/Makefile.am                     |   1 +
 src/expr/trigger.c                  | 265 ++++++++++++++++++++++++++++
 src/expr_ops.c                      |   2 +
 5 files changed, 312 insertions(+)
 create mode 100644 src/expr/trigger.c

diff --git a/include/libnftnl/expr.h b/include/libnftnl/expr.h
index 22cb9ae..d7196d2 100644
--- a/include/libnftnl/expr.h
+++ b/include/libnftnl/expr.h
@@ -158,6 +158,18 @@ enum {
 	__NFTNL_EXPR_NATTYPE_MAX
 };
 
+enum {
+	NFTNL_EXPR_TRIGGER_MODE	= NFTNL_EXPR_BASE,
+	NFTNL_EXPR_TRIGGER_TPROTO,
+	NFTNL_EXPR_TRIGGER_FPROTO,
+	NFTNL_EXPR_TRIGGER_TIMER,
+	NFTNL_EXPR_TRIGGER_TPORTS_MIN,
+	NFTNL_EXPR_TRIGGER_TPORTS_MAX,
+	NFTNL_EXPR_TRIGGER_FPORTS_MIN,
+	NFTNL_EXPR_TRIGGER_FPORTS_MAX,
+	__NFTNL_EXPR_TRIGGER_MAX,
+};
+
 enum {
 	NFTNL_EXPR_TPROXY_FAMILY	= NFTNL_EXPR_BASE,
 	NFTNL_EXPR_TPROXY_REG_ADDR,
diff --git a/include/linux/netfilter/nf_tables.h b/include/linux/netfilter/nf_tables.h
index ae86637..a2f2e8c 100644
--- a/include/linux/netfilter/nf_tables.h
+++ b/include/linux/netfilter/nf_tables.h
@@ -1451,6 +1451,38 @@ enum nft_nattype_attributes {
 };
 #define NFTA_NATTYPE_MAX		(__NFTA_NATTYPE_MAX - 1)
 
+enum nft_trigger_modes {
+	TRIGGER_MODE_DNAT,
+	TRIGGER_MODE_FORWARD_IN,
+	TRIGGER_MODE_FORWARD_OUT,
+};
+
+/**
+ * enum nft_trigger_attributes - nf_tables TRIGGER expression netlink attributes
+ *
+ * NFTA_TRIGGER_MODE:				TRIGGER mode (NLA_U32: nft_registers)
+ * NFTA_TRIGGER_TPROTO:			TRIGGER trigger-proto (NLA_U16: nft_registers)
+ * NFTA_TRIGGER_FPROTO:			TRIGGER forward-proto (NLA_U16: nft_registers)
+ * NFTA_TRIGGER_TIMER:			TRIGGER timer (NLA_U32: nft_registers)
+ * NFTA_TRIGGER_TPORTS_MIN:	TRIGGER trigger-ports range start (NLA_U32: nft_registers)
+ * NFTA_TRIGGER_TPORTS_MAX:	TRIGGER trigger-ports range end (NLA_U32: nft_registers)
+ * NFTA_TRIGGER_FPORTS_MIN:	TRIGGER forward-ports range start (NLA_U32: nft_registers)
+ * NFTA_TRIGGER_FPORTS_MAX:	TRIGGER forward-ports range end (NLA_U32: nft_registers)
+ */
+enum nft_trigger_attributes {
+	NFTA_TRIGGER_UNSPEC,
+	NFTA_TRIGGER_MODE,
+	NFTA_TRIGGER_TPROTO,
+	NFTA_TRIGGER_FPROTO,
+	NFTA_TRIGGER_TIMER,
+	NFTA_TRIGGER_TPORTS_MIN,
+	NFTA_TRIGGER_TPORTS_MAX,
+	NFTA_TRIGGER_FPORTS_MIN,
+	NFTA_TRIGGER_FPORTS_MAX,
+	__NFTA_TRIGGER_MAX,
+};
+#define NFTA_TRIGGER_MAX		(__NFTA_TRIGGER_MAX - 1)
+
 /**
  * enum nft_tproxy_attributes - nf_tables tproxy expression netlink attributes
  *
diff --git a/src/Makefile.am b/src/Makefile.am
index aa28fbf..a1ce5af 100644
--- a/src/Makefile.am
+++ b/src/Makefile.am
@@ -46,6 +46,7 @@ libnftnl_la_SOURCES = utils.c		\
 		      expr/numgen.c	\
 		      expr/nat.c	\
 		      expr/nattype.c	\
+					expr/trigger.c	\
 		      expr/tproxy.c	\
 		      expr/objref.c	\
 		      expr/payload.c	\
diff --git a/src/expr/trigger.c b/src/expr/trigger.c
new file mode 100644
index 0000000..6624a60
--- /dev/null
+++ b/src/expr/trigger.c
@@ -0,0 +1,265 @@
+/*
+ * Authors:
+ * 	Yinxsun Sun <quic_yinxsun@quicinc.com>
+ */
+/* Copyright (c) 2024 Qualcomm Innovation Center, Inc. All rights reserved.
+ */
+
+#include "internal.h"
+
+#include <arpa/inet.h>
+#include <errno.h>
+#include <libmnl/libmnl.h>
+#include <libnftnl/expr.h>
+#include <libnftnl/rule.h>
+#include <limits.h>
+#include <linux/netfilter/nf_tables.h>
+#include <netinet/in.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <string.h>
+#include <sys/types.h>
+
+struct nftnl_expr_trigger {
+  enum nft_trigger_modes mode;
+  uint32_t tproto;
+  uint32_t fproto;
+  uint32_t timer;
+  enum nft_registers sreg_tports_min;
+  enum nft_registers sreg_tports_max;
+  enum nft_registers sreg_fports_min;
+  enum nft_registers sreg_fports_max;
+};
+
+static int nftnl_expr_trigger_set(struct nftnl_expr *e, uint16_t type,
+                                  const void *data, uint32_t data_len) {
+  struct nftnl_expr_trigger *trigger = nftnl_expr_data(e);
+
+  switch (type) {
+  case NFTNL_EXPR_TRIGGER_MODE:
+    memcpy(&trigger->mode, data, sizeof(trigger->mode));
+    break;
+  case NFTNL_EXPR_TRIGGER_TPROTO:
+    memcpy(&trigger->tproto, data, sizeof(trigger->tproto));
+    break;
+  case NFTNL_EXPR_TRIGGER_FPROTO:
+    memcpy(&trigger->fproto, data, sizeof(trigger->fproto));
+    break;
+  case NFTNL_EXPR_TRIGGER_TIMER:
+    memcpy(&trigger->timer, data, sizeof(trigger->timer));
+    break;
+  case NFTNL_EXPR_TRIGGER_TPORTS_MIN:
+    memcpy(&trigger->sreg_tports_min, data, sizeof(trigger->sreg_tports_min));
+    break;
+  case NFTNL_EXPR_TRIGGER_TPORTS_MAX:
+    memcpy(&trigger->sreg_tports_max, data, sizeof(trigger->sreg_tports_max));
+    break;
+  case NFTNL_EXPR_TRIGGER_FPORTS_MIN:
+    memcpy(&trigger->sreg_fports_min, data, sizeof(trigger->sreg_fports_min));
+    break;
+  case NFTNL_EXPR_TRIGGER_FPORTS_MAX:
+    memcpy(&trigger->sreg_fports_max, data, sizeof(trigger->sreg_fports_max));
+    break;
+  default:
+    return -1;
+  }
+
+  return 0;
+}
+
+static const void *nftnl_expr_trigger_get(const struct nftnl_expr *e,
+                                          uint16_t type, uint32_t *data_len) {
+  struct nftnl_expr_trigger *trigger = nftnl_expr_data(e);
+
+  switch (type) {
+  case NFTNL_EXPR_TRIGGER_MODE:
+    *data_len = sizeof(trigger->mode);
+    return &trigger->mode;
+  case NFTNL_EXPR_TRIGGER_TPROTO:
+    *data_len = sizeof(trigger->tproto);
+    return &trigger->tproto;
+  case NFTNL_EXPR_TRIGGER_FPROTO:
+    *data_len = sizeof(trigger->fproto);
+    return &trigger->fproto;
+  case NFTNL_EXPR_TRIGGER_TIMER:
+    *data_len = sizeof(trigger->timer);
+    return &trigger->timer;
+  case NFTNL_EXPR_TRIGGER_TPORTS_MIN:
+    *data_len = sizeof(trigger->sreg_tports_min);
+    return &trigger->sreg_tports_min;
+  case NFTNL_EXPR_TRIGGER_TPORTS_MAX:
+    *data_len = sizeof(trigger->sreg_tports_max);
+    return &trigger->sreg_tports_max;
+  case NFTNL_EXPR_TRIGGER_FPORTS_MIN:
+    *data_len = sizeof(trigger->sreg_fports_min);
+    return &trigger->sreg_fports_min;
+  case NFTNL_EXPR_TRIGGER_FPORTS_MAX:
+    *data_len = sizeof(trigger->sreg_fports_max);
+    return &trigger->sreg_fports_max;
+  }
+
+  return NULL;
+}
+
+static int nftnl_expr_trigger_cb(const struct nlattr *attr, void *data) {
+  const struct nlattr **tb = data;
+  int type = mnl_attr_get_type(attr);
+
+  if (mnl_attr_type_valid(attr, NFTA_TRIGGER_MAX) < 0)
+    return MNL_CB_OK;
+
+  switch (type) {
+  case NFTA_TRIGGER_MODE:
+  case NFTA_TRIGGER_TPROTO:
+  case NFTA_TRIGGER_FPROTO:
+  case NFTA_TRIGGER_TIMER:
+  case NFTA_TRIGGER_TPORTS_MIN:
+  case NFTA_TRIGGER_TPORTS_MAX:
+  case NFTA_TRIGGER_FPORTS_MIN:
+  case NFTA_TRIGGER_FPORTS_MAX:
+    if (mnl_attr_validate(attr, MNL_TYPE_U32) < 0)
+      abi_breakage();
+    break;
+  }
+
+  tb[type] = attr;
+  return MNL_CB_OK;
+}
+
+static int nftnl_expr_trigger_parse(struct nftnl_expr *e, struct nlattr *attr) {
+  struct nftnl_expr_trigger *trigger = nftnl_expr_data(e);
+  struct nlattr *tb[NFTA_TRIGGER_MAX + 1] = {};
+
+  if (mnl_attr_parse_nested(attr, nftnl_expr_trigger_cb, tb) < 0)
+    return -1;
+
+  if (tb[NFTA_TRIGGER_MODE]) {
+    trigger->mode = ntohl(mnl_attr_get_u32(tb[NFTA_TRIGGER_MODE]));
+    e->flags |= (1 << NFTNL_EXPR_TRIGGER_MODE);
+  }
+  if (tb[NFTA_TRIGGER_TPROTO]) {
+    trigger->tproto = ntohl(mnl_attr_get_u32(tb[NFTA_TRIGGER_TPROTO]));
+    e->flags |= (1 << NFTNL_EXPR_TRIGGER_TPROTO);
+  }
+  if (tb[NFTA_TRIGGER_FPROTO]) {
+    trigger->fproto = ntohl(mnl_attr_get_u32(tb[NFTA_TRIGGER_FPROTO]));
+    e->flags |= (1 << NFTNL_EXPR_TRIGGER_FPROTO);
+  }
+  if (tb[NFTA_TRIGGER_TIMER]) {
+    trigger->timer = ntohl(mnl_attr_get_u32(tb[NFTA_TRIGGER_TIMER]));
+    e->flags |= (1 << NFTNL_EXPR_TRIGGER_TIMER);
+  }
+  if (tb[NFTA_TRIGGER_TPORTS_MIN]) {
+    trigger->sreg_tports_min = ntohl(mnl_attr_get_u32(tb[NFTA_TRIGGER_TPORTS_MIN]));
+    e->flags |= (1 << NFTNL_EXPR_TRIGGER_TPORTS_MIN);
+  }
+  if (tb[NFTA_TRIGGER_TPORTS_MAX]) {
+    trigger->sreg_tports_max = ntohl(mnl_attr_get_u32(tb[NFTA_TRIGGER_TPORTS_MAX]));
+    e->flags |= (1 << NFTNL_EXPR_TRIGGER_TPORTS_MAX);
+  }
+  if (tb[NFTA_TRIGGER_FPORTS_MIN]) {
+    trigger->sreg_fports_min = ntohl(mnl_attr_get_u32(tb[NFTA_TRIGGER_FPORTS_MIN]));
+    e->flags |= (1 << NFTNL_EXPR_TRIGGER_FPORTS_MIN);
+  }
+  if (tb[NFTA_TRIGGER_FPORTS_MAX]) {
+    trigger->sreg_fports_max = ntohl(mnl_attr_get_u32(tb[NFTA_TRIGGER_FPORTS_MAX]));
+    e->flags |= (1 << NFTNL_EXPR_TRIGGER_FPORTS_MAX);
+  }
+
+  return 0;
+}
+
+static void nftnl_expr_trigger_build(struct nlmsghdr *nlh,
+                                     const struct nftnl_expr *e) {
+  struct nftnl_expr_trigger *trigger = nftnl_expr_data(e);
+
+  if (e->flags & (1 << NFTNL_EXPR_TRIGGER_MODE))
+    mnl_attr_put_u32(nlh, NFTA_TRIGGER_MODE, htonl(trigger->mode));
+  if (e->flags & (1 << NFTNL_EXPR_TRIGGER_TPROTO))
+    mnl_attr_put_u32(nlh, NFTA_TRIGGER_TPROTO, htonl(trigger->tproto));
+  if (e->flags & (1 << NFTNL_EXPR_TRIGGER_FPROTO))
+    mnl_attr_put_u32(nlh, NFTA_TRIGGER_FPROTO, htonl(trigger->fproto));
+  if (e->flags & (1 << NFTNL_EXPR_TRIGGER_TIMER))
+    mnl_attr_put_u32(nlh, NFTA_TRIGGER_TIMER, htonl(trigger->timer));
+  if (e->flags & (1 << NFTNL_EXPR_TRIGGER_TPORTS_MIN))
+    mnl_attr_put_u32(nlh, NFTA_TRIGGER_TPORTS_MIN, htonl(trigger->sreg_tports_min));
+  if (e->flags & (1 << NFTNL_EXPR_TRIGGER_TPORTS_MAX))
+    mnl_attr_put_u32(nlh, NFTA_TRIGGER_TPORTS_MAX, htonl(trigger->sreg_tports_max));
+  if (e->flags & (1 << NFTNL_EXPR_TRIGGER_FPORTS_MIN))
+    mnl_attr_put_u32(nlh, NFTA_TRIGGER_FPORTS_MIN, htonl(trigger->sreg_fports_min));
+  if (e->flags & (1 << NFTNL_EXPR_TRIGGER_FPORTS_MAX))
+    mnl_attr_put_u32(nlh, NFTA_TRIGGER_FPORTS_MAX, htonl(trigger->sreg_fports_max));
+}
+
+static inline const char *triggermode2str(uint16_t triggermode) {
+  switch (triggermode) {
+  case TRIGGER_MODE_DNAT:
+    return "dnat";
+	case TRIGGER_MODE_FORWARD_IN:
+    return "forward_in";
+	case TRIGGER_MODE_FORWARD_OUT:
+    return "forward_out";
+  default:
+    return "null";
+  }
+}
+
+static int nftnl_expr_trigger_snprintf(char *buf, size_t remain, uint32_t flags,
+                                       const struct nftnl_expr *e) {
+  struct nftnl_expr_trigger *trigger = nftnl_expr_data(e);
+  int offset = 0, ret = 0;
+
+  if (e->flags & (1 << NFTNL_EXPR_TRIGGER_MODE)) {
+    ret = snprintf(buf, remain, "mode %s ", triggermode2str(trigger->mode));
+    SNPRINTF_BUFFER_SIZE(ret, remain, offset);
+  }
+  if (e->flags & (1 << NFTNL_EXPR_TRIGGER_TPROTO)) {
+    ret = snprintf(buf + offset, remain,
+              "tproto %u ", trigger->tproto);
+    SNPRINTF_BUFFER_SIZE(ret, remain, offset);
+  }
+  if (e->flags & (1 << NFTNL_EXPR_TRIGGER_FPROTO)) {
+    ret = snprintf(buf + offset, remain,
+              "fproto %u ", trigger->fproto);
+    SNPRINTF_BUFFER_SIZE(ret, remain, offset);
+  }
+  if (e->flags & (1 << NFTNL_EXPR_TRIGGER_TIMER)) {
+    ret = snprintf(buf + offset, remain,
+              "timer %u ", trigger->timer);
+    SNPRINTF_BUFFER_SIZE(ret, remain, offset);
+  }
+  if (e->flags & (1 << NFTNL_EXPR_TRIGGER_TPORTS_MIN)) {
+    ret = snprintf(buf + offset, remain,
+              "tports_min reg %u ", trigger->sreg_tports_min);
+    SNPRINTF_BUFFER_SIZE(ret, remain, offset);
+  }
+  if (e->flags & (1 << NFTNL_EXPR_TRIGGER_TPORTS_MAX)) {
+    ret = snprintf(buf + offset, remain,
+              "tports_max reg %u ", trigger->sreg_tports_max);
+    SNPRINTF_BUFFER_SIZE(ret, remain, offset);
+  }
+  if (e->flags & (1 << NFTNL_EXPR_TRIGGER_FPORTS_MIN)) {
+    ret = snprintf(buf + offset, remain,
+              "fports_min reg %u ", trigger->sreg_fports_min);
+    SNPRINTF_BUFFER_SIZE(ret, remain, offset);
+  }
+  if (e->flags & (1 << NFTNL_EXPR_TRIGGER_FPORTS_MAX)) {
+    ret = snprintf(buf + offset, remain,
+              "fports_max reg %u ", trigger->sreg_fports_max);
+    SNPRINTF_BUFFER_SIZE(ret, remain, offset);
+  }
+
+
+  return offset;
+}
+
+struct expr_ops expr_ops_trigger = {
+  .name = "TRIGGER",
+  .alloc_len = sizeof(struct nftnl_expr_trigger),
+  .max_attr = NFTA_TRIGGER_MAX,
+  .set = nftnl_expr_trigger_set,
+  .get = nftnl_expr_trigger_get,
+  .parse = nftnl_expr_trigger_parse,
+  .build = nftnl_expr_trigger_build,
+  .output = nftnl_expr_trigger_snprintf,
+};
\ No newline at end of file
diff --git a/src/expr_ops.c b/src/expr_ops.c
index 7548569..351646b 100644
--- a/src/expr_ops.c
+++ b/src/expr_ops.c
@@ -44,6 +44,7 @@ extern struct expr_ops expr_ops_tunnel;
 extern struct expr_ops expr_ops_osf;
 extern struct expr_ops expr_ops_xfrm;
 extern struct expr_ops expr_ops_nattype;
+extern struct expr_ops expr_ops_trigger;
 
 static struct expr_ops expr_ops_notrack = {
 	.name	= "notrack",
@@ -91,6 +92,7 @@ static struct expr_ops *expr_ops[] = {
 	&expr_ops_osf,
 	&expr_ops_xfrm,
 	&expr_ops_nattype,
+	&expr_ops_trigger,
 	NULL,
 };
 
