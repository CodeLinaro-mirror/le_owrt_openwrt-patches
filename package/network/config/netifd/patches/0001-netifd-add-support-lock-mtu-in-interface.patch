From 16aa21121781c807bb1a5f3fe00f78a8795ebaab Mon Sep 17 00:00:00 2001
From: HuaWen CHEN <quic_huawenc@quicinc.com>
Date: Wed, 6 Dec 2023 09:39:15 +0800
Subject: [PATCH] netifd: add support lock mtu in interface

Signed-off by: HuaWen CHEN <quic_huawenc@quicinc.com>
---
 interface-ip.c | 6 ++++++
 interface-ip.h | 1 +
 interface.c    | 5 +++++
 interface.h    | 1 +
 system-linux.c | 9 ++++++++-
 5 files changed, 21 insertions(+), 1 deletion(-)

diff --git a/interface-ip.c b/interface-ip.c
index ab4a5cf..4f76dac 100644
--- a/interface-ip.c
+++ b/interface-ip.c
@@ -333,6 +333,12 @@ interface_set_route_info(struct interface *iface, struct device_route *route)
 	if (!(route->flags & DEVROUTE_METRIC))
 		route->metric = iface->metric;
 
+	if (!(route->flags & DEVROUTE_METRIC))
+		route->metric = iface->metric;
+
+	route->lockmtu = iface->proto_ip.lockmtu;
+    netifd_log_message(L_DEBUG, "lockmtu: %d\n", route->lockmtu);
+
 	if (!(route->flags & DEVROUTE_TABLE)) {
 		route->table = (v6) ? iface->ip6table : iface->ip4table;
 		if (route->table)
diff --git a/interface-ip.h b/interface-ip.h
index 8843349..fdf9191 100644
--- a/interface-ip.h
+++ b/interface-ip.h
@@ -92,6 +92,7 @@ struct device_route {
 	bool enabled;
 	bool keep;
 	bool failed;
+	bool lockmtu;
 
 	union if_addr nexthop;
 	int mtu;
diff --git a/interface.c b/interface.c
index 89654f9..a1830ee 100644
--- a/interface.c
+++ b/interface.c
@@ -55,6 +55,7 @@ enum {
 	IFACE_ATTR_IP6IFACEID,
 	IFACE_ATTR_FORCE_LINK,
 	IFACE_ATTR_IP6WEIGHT,
+	IFACE_ATTR_LOCKMTU,
 	IFACE_ATTR_MAX
 };
 
@@ -84,6 +85,7 @@ static const struct blobmsg_policy iface_attrs[IFACE_ATTR_MAX] = {
 	[IFACE_ATTR_IP6IFACEID] = { .name = "ip6ifaceid", .type = BLOBMSG_TYPE_STRING },
 	[IFACE_ATTR_FORCE_LINK] = { .name = "force_link", .type = BLOBMSG_TYPE_BOOL },
 	[IFACE_ATTR_IP6WEIGHT] = { .name = "ip6weight", .type = BLOBMSG_TYPE_INT32 },
+	[IFACE_ATTR_LOCKMTU] = { .name = "lockmtu", .type = BLOBMSG_TYPE_BOOL },
 };
 
 const struct uci_blob_param_list interface_attr_list = {
@@ -854,6 +856,9 @@ interface_alloc(const char *name, struct blob_attr *config, bool dynamic)
 	iface->proto_ip.no_dns =
 		!blobmsg_get_bool_default(tb[IFACE_ATTR_PEERDNS], true);
 
+	iface->proto_ip.lockmtu =
+		blobmsg_get_bool_default(tb[IFACE_ATTR_LOCKMTU], false);
+
 	if ((cur = tb[IFACE_ATTR_DNS]))
 		interface_add_dns_server_list(&iface->config_ip, cur);
 
diff --git a/interface.h b/interface.h
index 9343ade..d3b5797 100644
--- a/interface.h
+++ b/interface.h
@@ -78,6 +78,7 @@ struct interface_ip_settings {
 	bool no_defaultroute;
 	bool no_dns;
 	bool no_delegation;
+	bool lockmtu;
 
 	struct vlist_tree addr;
 	struct vlist_tree route;
diff --git a/system-linux.c b/system-linux.c
index a700d31..cb1bd68 100644
--- a/system-linux.c
+++ b/system-linux.c
@@ -2671,6 +2671,7 @@ static int system_rt(struct device *dev, struct device_route *route, int cmd)
 	int alen = ((route->flags & DEVADDR_FAMILY) == DEVADDR_INET4) ? 4 : 16;
 	bool have_gw;
 	unsigned int flags = 0;
+	unsigned int mxlock = 0;
 
 	if (alen == 4)
 		have_gw = !!route->nexthop.in.s_addr;
@@ -2763,6 +2764,12 @@ static int system_rt(struct device *dev, struct device_route *route, int cmd)
 
 		nla_put_u32(msg, RTAX_MTU, route->mtu);
 
+		if(route->lockmtu)
+		{
+			mxlock |= (1<<RTAX_MTU);
+			nla_put_u32(msg, RTAX_LOCK, mxlock);
+			netifd_log_message(L_DEBUG, "route mtu lock with (lock:%d)%d(mask:%d)\n", mxlock, route->mtu, route->mask);
+		}
 		nla_nest_end(msg, metrics);
 	}
 
@@ -3641,7 +3648,7 @@ static void system_vxlan_map_bool_attr(struct nl_msg *msg, struct blob_attr **tb
 
 		if ((attrtype == IFLA_VXLAN_GBP) && val)
 			nla_put_flag(msg, attrtype);
-		else 
+		else
 			nla_put_u8(msg, attrtype, val);
 
 	}
-- 
