From 4899823d0fbf092319d05ca567f4b118aae95405 Mon Sep 17 00:00:00 2001
From: ayukuma <quic_ayukuma@quicinc.com>
Date: Sun, 6 Oct 2024 15:14:56 +0530
Subject: [PATCH] ct_status_dnat_v4_patch_02

This patch will help to configure ct status dnat rule only for ipv4.

Signed-off-by: Ayush Kumar<quic_ayukuma@quicinc.com>
---
 root/usr/share/firewall4/templates/ruleset.uc | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/root/usr/share/firewall4/templates/ruleset.uc b/root/usr/share/firewall4/templates/ruleset.uc
index 2bec4d9..3a0dcbc 100644
--- a/root/usr/share/firewall4/templates/ruleset.uc
+++ b/root/usr/share/firewall4/templates/ruleset.uc
@@ -225,7 +225,7 @@ table inet fw4 {
 		{%+ include("rule.uc", { fw4, zone, rule }) %}
 {%  endfor %}
 {%  if (zone.dflags.dnat): %}
-		ct status dnat accept comment "!fw4: Accept port redirections"
+		meta nfproto ipv4 ct status dnat accept comment "!fw4: Accept ipv4 port redirections"
 {%  endif %}
 {%  fw4.includes('chain-append', `input_${zone.name}`) %}
 		jump {{ zone.input }}_from_{{ zone.name }}
@@ -246,7 +246,7 @@ table inet fw4 {
 		{%+ include("rule.uc", { fw4, zone, rule }) %}
 {%  endfor %}
 {%  if (zone.dflags.dnat): %}
-		ct status dnat accept comment "!fw4: Accept port forwards"
+		meta nfproto ipv4 ct status dnat accept comment "!fw4: Accept ipv4 port forwards"
 {%  endif %}
 {%  fw4.includes('chain-append', `forward_${zone.name}`) %}
 		jump {{ zone.forward }}_to_{{ zone.name }}
-- 
