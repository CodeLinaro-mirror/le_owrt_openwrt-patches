+/* More data was received from TCP connection */
+static void router_managed_handle_pd_data(struct ustream *s, _unused int bytes_new)
+{
+	struct ustream_fd *fd = container_of(s, struct ustream_fd, stream);
+	struct ra_prefix_assignment *c = container_of(fd, struct ra_prefix_assignment, managed_sock);
+	time_t now = odhcpd_time();
+	bool first = c->managed_size < 0;
+
+	for (;;) {
+		int pending;
+		char *data = ustream_get_read_buf(s, &pending);
+		char *end = memmem(data, pending, "\n\n", 2);
+
+		if(data != 0)
+		{
+			syslog(LOG_INFO, "router_managed_handle_pd_data: receive %s(pending:%d, new:%d)", data, pending, bytes_new);
+		}
+		else
+		{
+			syslog(LOG_INFO, "router_managed_handle_pd_data: not receive data(pending:%d, new:%d)", pending, bytes_new);
+		}
+
+		if (!end)
+		{
+			syslog(LOG_INFO, "router_managed_handle_pd_data: end break");
+			break;
+		}
+
+		end += 2;
+		end[-1] = 0;
+
+		c->managed_size = 0;
+
+		char *saveptr;
+		for (char *line = strtok_r(data, "\n", &saveptr); line; line = strtok_r(NULL, "\n", &saveptr)) {
+			c->managed = realloc(c->managed, (c->managed_size + 1) * sizeof(*c->managed));
+			struct odhcpd_ipaddr *n = &c->managed[c->managed_size];
+
+			syslog(LOG_INFO, "router_managed_handle_pd_data: receive %s(%d)", line, bytes_new);
+
+			char *saveptr2, *x = strtok_r(line, "/", &saveptr2);
+			if (!x || inet_pton(AF_INET6, x, &n->addr) < 1)
+				continue;
+
+			x = strtok_r(NULL, ",", &saveptr2);
+			if (sscanf(x, "%hhu", &n->prefix) < 1)
+				continue;
+
+			x = strtok_r(NULL, ",", &saveptr2);
+			if (sscanf(x, "%u", &n->preferred_lt) < 1)
+				continue;
+
+			x = strtok_r(NULL, ",", &saveptr2);
+			if (sscanf(x, "%u", &n->valid_lt) < 1)
+				continue;
+
+			if (n->preferred_lt > n->valid_lt)
+				continue;
+
+			if (UINT32_MAX - now < n->preferred_lt)
+				n->preferred_lt = UINT32_MAX;
+			else
+				n->preferred_lt += now;
+
+			if (UINT32_MAX - now < n->valid_lt)
+				n->valid_lt = UINT32_MAX;
+			else
+				n->valid_lt += now;
+
+			n->dprefix = 0;
+
+			++c->managed_size;
+		}
+
+		ustream_consume(s, end - data);
+	}
+
+	if (first && c->managed_size == 0)
+		free_ra_prefix_assignment(c);
+	else if (first)
+		c->valid_until = now + 150;
+}
+
+
+static void router_managed_handle_pd_write_done(struct ustream *s, int bytes)
+{
+	syslog(LOG_INFO, "router_managed_handle_pd_write_done: send success (num: %d)", bytes);
+}
+
+static int send_router_advert(struct interface *iface, const struct in6_addr *from);
+
+static void __router_apply_lease(struct ra_prefix_assignment *a,
+		struct odhcpd_ipaddr *addrs, ssize_t addr_len, bool add)
+{
+	for (ssize_t i = 0; i < addr_len; ++i) {
+		struct in6_addr prefix;
+
+		if (ADDR_MATCH_PIO_FILTER(&addrs[i], a->iface))
+			continue;
+
+		prefix = addrs[i].addr.in6;
+		prefix.s6_addr32[1] |= htonl(0);
+		prefix.s6_addr32[2] = prefix.s6_addr32[3] = 0;
+		netlink_setup_route(&prefix, (a->managed_size) ? addrs[i].prefix : 64,
+				a->iface->ifindex, NULL, 1024, add);
+	}
+}
+
+static void router_apply_lease(struct ra_prefix_assignment *a, bool add)
+{
+	struct interface *iface = a->iface;
+	struct odhcpd_ipaddr *addrs = (a->managed) ? a->managed : iface->addr6;
+	ssize_t addrlen = (a->managed) ? a->managed_size : (ssize_t)iface->addr6_len;
+
+	__router_apply_lease(a, addrs, addrlen, add);
+}
+
+/* TCP transmission has ended, either because of success or timeout or other error */
+static void router_managed_handle_pd_done(struct ustream *s)
+{
+	struct ustream_fd *fd = container_of(s, struct ustream_fd, stream);
+	struct ra_prefix_assignment *c = container_of(fd, struct ra_prefix_assignment, managed_sock);
+
+	syslog(LOG_INFO, "router_managed_handle_pd_done: send RA with lifetime 0");
+
+	if(c && c->managed)
+	{
+		c->managed->preferred_lt=1;
+		c->managed->valid_lt=INVALID_TIME_VALUE; //mark as invalid time value
+		//send RA with lifetime=0
+		send_router_advert(c->iface, &(c->from));
+		router_apply_lease(c, false);
+
+		//free the assignment
+		free_ra_prefix_assignment(c);
+	}
+}
+
+static struct ra_prefix_assignment* router_get_delegation_prefix
+(struct interface *iface, const struct in6_addr *from)
+{
+	struct ra_prefix_assignment *c, *a = NULL;
+	if(from == NULL)
+		return NULL;
+
+	//find assignment
+	list_for_each_entry(c, &iface->ra_prefix_assignments, head) {
+		if (!memcmp(&(c->from), from, sizeof(struct in6_addr))) {
+			a = c;
+			syslog(LOG_INFO, "router_get_delegation_prefix: get prefix ready");
+			break;
+		}
+	}
+
+	if(a != NULL)
+		return a;
+
+	// allocate new assignment and trigger new request
+	a = alloc_ra_prefix_assignment();
+	if (!a)
+		return NULL;
+
+	memcpy(&(a->from), from, sizeof(struct in6_addr));
+	a->iface=iface;
+
+	if (iface->dhcpv6_pd_manager[0]) {
+		int fd = usock(USOCK_UNIX | USOCK_TCP, iface->dhcpv6_pd_manager, NULL);
+
+		syslog(LOG_INFO, "router_get_delegation_prefix: open socket to %s", iface->dhcpv6_pd_manager);
+		if (fd >= 0) {
+			struct pollfd pfd = { .fd = fd, .events = POLLIN };
+			char iaidbuf[17] = {0};
+
+			odhcpd_hexlify(iaidbuf, from->s6_addr + 8, 8);
+
+			a->managed_sock.stream.notify_read = router_managed_handle_pd_data;
+			a->managed_sock.stream.notify_state = router_managed_handle_pd_done;
+			a->managed_sock.stream.notify_write = router_managed_handle_pd_write_done;
+			ustream_fd_init(&a->managed_sock, fd);
+			ustream_printf(&a->managed_sock.stream, "%s,%x\n::/%d,0,0\n\n",
+							iaidbuf, 0, 64);
+			syslog(LOG_INFO, "send %s,%x\n::/%d,0,0\n\n to pd_manager",iaidbuf, 0, 64);
+			ustream_write_pending(&a->managed_sock.stream);
+
+			a->valid_until = odhcpd_time() + 15;
+
+			list_add(&a->head, &iface->ra_prefix_assignments);
+
+			/* Wait initial period of up to 250ms for immediate assignment */
+			if (poll(&pfd, 1, 250) < 0) {
+				syslog(LOG_ERR, "poll(): %m");
+				return NULL;
+			}
+
+			router_managed_handle_pd_data(&a->managed_sock.stream, 0);
+
+			if (fcntl(fd, F_GETFL) >= 0 && a->managed_size > 0)
+				return a;
+		}
+
+		return NULL;
+	}
+	else
+		return NULL;
+
+}
+
+
 /* Router Advert server mode */
