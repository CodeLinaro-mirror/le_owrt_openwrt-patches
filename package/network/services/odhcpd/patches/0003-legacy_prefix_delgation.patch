 {
@@ -575,6 +787,8 @@ static int send_router_advert(struct interface *iface, const struct in6_addr *fr
 	iov[IOV_RA_ADV].iov_base = (char *)&adv;
 	iov[IOV_RA_ADV].iov_len = sizeof(adv);
 
+	if(iface->qcmap_prefix_delegation_mode != QCMAP_PREFIX_DELEGATION_MODE_LEGACY)
+	{
 	valid_addr_cnt = (iface->timer_rs.cb /* if not shutdown */ ? iface->addr6_len : 0);
 	invalid_addr_cnt = iface->invalid_addr6_len;
 
@@ -624,6 +838,52 @@ static int send_router_advert(struct interface *iface, const struct in6_addr *fr
 			}
 		}
 	}
+	}
+	else
+	{
+		struct ra_prefix_assignment *a = NULL;
+		if(from == NULL)
+			return 1000*1000;
+
+		if((a = router_get_delegation_prefix(iface, from)))
+		{
+			if(a->managed == NULL)
+			{
+				syslog(LOG_INFO, "prefix not yet ready, need wait");
+				return 0;
+			}
+			if(a->managed->valid_lt == INVALID_TIME_VALUE)
+			{
+				valid_addr_cnt = 0;
+				invalid_addr_cnt = a->managed_size;
+			}
+			else
+			{
+				valid_addr_cnt = a->managed_size;
