+inline static struct ra_prefix_assignment *alloc_ra_prefix_assignment()
+{
+	struct ra_prefix_assignment *a = calloc(1, sizeof(*a) );
+
+	if (!a)
+		return NULL;
+
+	INIT_LIST_HEAD(&a->head);
+
+	return a;
+}
