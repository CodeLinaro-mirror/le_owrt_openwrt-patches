+// Function to read network interface downstream configuration
+static char* get_network_downstream(const char *interface_name)
+{
+	struct uci_context *uci = uci_alloc_context();
+	struct uci_package *network = NULL;
+	char *downstream = NULL;
+	
+	if (!uci)
+		return NULL;
+	
+	if (uci_load(uci, "network", &network) != UCI_OK)
+		goto cleanup;
+	
+	struct uci_element *e;
+	uci_foreach_element(&network->sections, e) {
+		struct uci_section *s = uci_to_section(e);
+		if (strcmp(s->type, "interface") != 0)
+			continue;
+			
+		if (strcmp(s->e.name, interface_name) == 0) {
+			struct uci_option *o = uci_lookup_option(uci, s, "downstream");
+			if (o && o->type == UCI_TYPE_STRING) {
+				downstream = strdup(o->v.string);
+				break;
+			}
+		}
+	}
+	
+cleanup:
+	if (network)
+		uci_unload(uci, network);
+	uci_free_context(uci);
+	return downstream;
+}
+
 static void set_interface_defaults(struct interface *iface)
 {
 	iface->ignore = true;
@@ -250,6 +289,12 @@ static void clean_interface(struct interface *iface)
 	free(iface->dhcpv4_ntp);
 	free(iface->dhcpv6_ntp);
 	free(iface->dhcpv6_sntp);
+	free(iface->circuitid);
+	iface->circuitid = NULL;
+	free(iface->neid);
+	iface->neid = NULL;
+	free(iface->downstream);
+	iface->downstream = NULL;
 	memset(&iface->ra, 0, sizeof(*iface) - offsetof(struct interface, ra));
 	set_interface_defaults(iface);
 }
@@ -1109,6 +1154,28 @@ int config_parse_interface(void *data, size_t len, const char *name, bool overwr
 	if ((c = tb[IFACE_ATTR_QCMAP_PREFIX_DELEGATION_MODE]))
 		iface->qcmap_prefix_delegation_mode = blobmsg_get_u32(c);
 
+	if ((c = tb[IFACE_ATTR_CIRCUITID])) {
+		char *new_circuitid = strdup(blobmsg_get_string(c));
+		if (!new_circuitid) {
+			/* Log error to syslog and indicate failure */
+			syslog(LOG_ERR, "Failed to allocate memory for circuitid");
+			return -1;
+		}
+		free(iface->circuitid);
+		iface->circuitid = new_circuitid;
+	}
+
+	if ((c = tb[IFACE_ATTR_NEID])) {
+		char *new_neid = strdup(blobmsg_get_string(c));
+		if (!new_neid) {
+			/* Log error to syslog and indicate failure */
+			syslog(LOG_ERR, "Failed to allocate memory for neid");
+			return -1;
+		}
+		free(iface->neid);
+		iface->neid = new_neid;
+	}
+
 	return 0;
 
 err:
@@ -1400,6 +1467,19 @@ void odhcpd_reload(void)
 	}
 
 
+	/* Read downstream configuration for master interfaces */
+	avl_for_each_element(&interfaces, i, avl) {
+		if (i->master) {
+			// Read downstream configuration from network interface
+			free(i->downstream);
+			i->downstream = get_network_downstream(i->name);
+			if (i->downstream) {
+				syslog(LOG_DEBUG, "Master interface %s has downstream: %s", 
+				       i->name, i->downstream);
+			}
+		}
+	}
+
 	avl_for_each_element_safe(&interfaces, i, avl, tmp) {
 		if (i->inuse) {
 			/* Resolve hybrid mode */
diff --git a/src/dhcpv6.c b/src/dhcpv6.c
index 6e127cd..6388476 100644
--- a/src/dhcpv6.c
+++ b/src/dhcpv6.c
@@ -28,6 +28,8 @@
 #ifdef DHCPV4_SUPPORT
 #include "dhcpv4.h"
 #endif
+#define RELAY_BUF_SIZE 9000  // Support jumbo frames
+#define MAX_OPTION_STRING_LEN 255
 
 static void relay_client_request(struct sockaddr_in6 *source,
 		const void *data, size_t len, struct interface *iface);
@@ -786,24 +788,29 @@ static struct odhcpd_ipaddr *relay_link_address(struct interface *iface)
 	return addr;
 }
 
+/* Check if downstream interface is authorized to relay to master interface */
+static bool is_downstream_authorized(struct interface *downstream, struct interface *master)
+{
+	if (!master->master || master->dhcpv6 != MODE_RELAY)
+		return false;
+	
+	if (!master->downstream)
+		return false; // No downstream config = no relay allowed
+	
+	// Check if downstream interface name matches master's downstream config
+	return (strcmp(master->downstream, downstream->name) == 0);
+}
+
 /* Relay client request (regular DHCPv6-relay) */
 static void relay_client_request(struct sockaddr_in6 *source,
 		const void *data, size_t len, struct interface *iface)
 {
 	const struct dhcpv6_relay_header *h = data;
-	/* Construct our forwarding envelope */
-	struct dhcpv6_relay_forward_envelope hdr = {
-		.msg_type = DHCPV6_MSG_RELAY_FORW,
-		.hop_count = 0,
-		.interface_id_type = htons(DHCPV6_OPT_INTERFACE_ID),
-		.interface_id_len = htons(sizeof(uint32_t)),
-		.relay_message_type = htons(DHCPV6_OPT_RELAY_MSG),
-		.relay_message_len = htons(len),
-	};
-	struct iovec iov[2] = {{&hdr, sizeof(hdr)}, {(void *)data, len}};
-	struct interface *c;
-	struct odhcpd_ipaddr *ip;
-	struct sockaddr_in6 s;
+	unsigned char relay_buf[RELAY_BUF_SIZE ];
+	size_t relay_len;
+	struct dhcpv6_relay_header *hdr = (struct dhcpv6_relay_header *)relay_buf;
+	unsigned char *opt_ptr;
+	unsigned char * const relay_buf_end = relay_buf + sizeof(relay_buf);
 
 	if (h->msg_type == DHCPV6_MSG_RELAY_REPL ||
 	    h->msg_type == DHCPV6_MSG_RECONFIGURE ||
@@ -813,47 +820,117 @@ static void relay_client_request(struct sockaddr_in6 *source,
 
 	syslog(LOG_DEBUG, "Got a DHCPv6-request on %s", iface->name);
 
+	/* 1. Add relay header fields */
+	hdr->msg_type = DHCPV6_MSG_RELAY_FORW;
+	hdr->hop_count = 0;
 	if (h->msg_type == DHCPV6_MSG_RELAY_FORW) { /* handle relay-forward */
 		if (h->hop_count >= DHCPV6_HOP_COUNT_LIMIT)
 			return; /* Invalid hop count */
-
-		hdr.hop_count = h->hop_count + 1;
+		hdr->hop_count = h->hop_count + 1;
 	}
 
-	/* use memcpy here as the destination fields are unaligned */
-	memcpy(&hdr.peer_address, &source->sin6_addr, sizeof(struct in6_addr));
-	memcpy(&hdr.interface_id_data, &iface->ifindex, sizeof(iface->ifindex));
+	memcpy(&hdr->peer_address, &source->sin6_addr, sizeof(struct in6_addr));
 
 	/* Detect public IP of slave interface to use as link-address */
-	ip = relay_link_address(iface);
+	struct odhcpd_ipaddr *ip = relay_link_address(iface);
 	if (ip)
-		memcpy(&hdr.link_address, &ip->addr.in6, sizeof(hdr.link_address));
+		memcpy(&hdr->link_address, &ip->addr.in6, sizeof(hdr->link_address));
+	else
+		memset(&hdr->link_address, 0, sizeof(hdr->link_address));
+
+	opt_ptr = hdr->options;
+
+	/* 2. Construct Interface-ID option (18) with Circuit ID */
+	if (iface->circuitid) {
+		size_t l = strlen(iface->circuitid);
+		if (l > MAX_OPTION_STRING_LEN) {
+			syslog(LOG_WARNING, "Circuit-ID too long (%zu bytes), truncating to %d", l, MAX_OPTION_STRING_LEN);
+			l = MAX_OPTION_STRING_LEN;
+		}
+		if (opt_ptr + 4 + l > relay_buf_end) {
+			syslog(LOG_ERR, "Buffer overflow: not enough space for Circuit-ID in Interface-ID");
+			return;
+		}
+
+		uint16_t type = htons(DHCPV6_OPT_INTERFACE_ID);
+		uint16_t length = htons(l);
+		memcpy(opt_ptr, &type, 2);
+		opt_ptr += 2;
+		memcpy(opt_ptr, &length, 2);
+		opt_ptr += 2;
+		memcpy(opt_ptr, iface->circuitid, l);
+		opt_ptr += l;
+	}
+
+	/* 3. Add Remote-ID option (37) with NEID (RFC 4649 format: Enterprise-Number + Remote-ID) */
+	if (iface->neid) {
+		size_t l = strlen(iface->neid);
+		if (l < 4) {
+			syslog(LOG_ERR, "NEID too short (%zu bytes), need at least 4 bytes for Enterprise-Number", l);
+			return;
+		}
+		if (l > MAX_OPTION_STRING_LEN) {
+			syslog(LOG_WARNING, "NEID too long (%zu bytes), truncating to %d", l, MAX_OPTION_STRING_LEN);
+			l = MAX_OPTION_STRING_LEN;
+		}
+		if (opt_ptr + 4 + l > relay_buf_end) {
+			syslog(LOG_ERR, "Buffer overflow: not enough space for NEID in Remote-ID");
+			return;
+		}
+
+		uint16_t type = htons(DHCPV6_OPT_REMOTE_ID);
+		uint16_t length = htons(l);
+		memcpy(opt_ptr, &type, 2);
+		opt_ptr += 2;
+		memcpy(opt_ptr, &length, 2);
+		opt_ptr += 2;
+		
+		/* RFC 4649: First 4 bytes = Enterprise-Number, rest = Remote-ID */
+		memcpy(opt_ptr, iface->neid, 4);  /* Enterprise-Number (4 bytes) */
+		opt_ptr += 4;
+		memcpy(opt_ptr, iface->neid + 4, l - 4);  /* Remote-ID (remaining bytes) */
+		opt_ptr += (l - 4);
+	}
+
+	/* 4. Add Relay-Msg option (9) */
+	if (opt_ptr + 4 + len > relay_buf_end) {
+		syslog(LOG_ERR, "Buffer overflow: not enough space for relayed message");
+		return;
+	}
+
+	uint16_t opt9_type = htons(DHCPV6_OPT_RELAY_MSG);
+	uint16_t opt9_len = htons(len);
+	memcpy(opt_ptr, &opt9_type, 2);
+	opt_ptr += 2;
+	memcpy(opt_ptr, &opt9_len, 2);
+	opt_ptr += 2;
+	memcpy(opt_ptr, data, len);
+	opt_ptr += len;
+
+	/* 5. Send the message */
+	relay_len = opt_ptr - relay_buf;
 
+	struct iovec iov = {relay_buf, relay_len};
+	struct interface *c;
+	struct sockaddr_in6 s;
 	memset(&s, 0, sizeof(s));
 	s.sin6_family = AF_INET6;
 	s.sin6_port = htons(DHCPV6_SERVER_PORT);
 	inet_pton(AF_INET6, ALL_DHCPV6_SERVERS, &s.sin6_addr);
 
 	avl_for_each_element(&interfaces, c, avl) {
-		if (!c->master || c->dhcpv6 != MODE_RELAY)
+		//  ADD FILTERING CHECK - only relay to authorized masters
+		if (!is_downstream_authorized(iface, c))
 			continue;
 
 		if (!ip) {
-			/* No suitable address! Is the slave not configured yet?
-			 * Detect public IP of master interface and use it instead
-			 * This is WRONG and probably violates the RFC. However
-			 * otherwise we have a hen and egg problem because the
-			 * slave-interface cannot be auto-configured. */
-			ip = relay_link_address(c);
-			if (!ip)
-				continue; /* Could not obtain a suitable address */
-
-			memcpy(&hdr.link_address, &ip->addr.in6, sizeof(hdr.link_address));
-			ip = NULL;
+			struct odhcpd_ipaddr *master_ip = relay_link_address(c);
+			if (master_ip)
+				memcpy(&hdr->link_address, &master_ip->addr.in6, sizeof(hdr->link_address));
 		}
 
-		syslog(LOG_DEBUG, "Sending a DHCPv6-relay-forward on %s", c->name);
-
-		odhcpd_send(c->dhcpv6_event.uloop.fd, &s, iov, 2, c);
+		syslog(LOG_DEBUG, "Sending DHCPv6-relay-forward from %s to authorized master %s", 
+		       iface->name, c->name);
+		odhcpd_send(c->dhcpv6_event.uloop.fd, &s, &iov, 1, c);
 	}
 }
