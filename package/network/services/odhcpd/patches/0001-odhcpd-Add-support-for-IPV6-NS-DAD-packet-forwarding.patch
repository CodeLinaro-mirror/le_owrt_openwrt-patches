+static struct in6_addr all_routers_in6_addr;
+static struct in6_addr all_mld2_routers_in6_addr;
+static struct in6_addr all_hosts_in6_addr;
+
 /* Filter ICMPv6 messages of type neighbor solicitation */
 static struct sock_filter bpf[] = {
 	BPF_STMT(BPF_LD | BPF_B | BPF_ABS, offsetof(struct ip6_hdr, ip6_nxt)),
@@ -49,7 +58,22 @@ static struct sock_filter bpf[] = {
 	BPF_STMT(BPF_RET | BPF_K, 0xffffffff),
 	BPF_STMT(BPF_RET | BPF_K, 0),
 };
+struct sock_filter bpf_ns_na[] =
+{
+	/* offsets are adjusted assuming message is captured at IPv6 header */
+	/* goto first byte and compare version 6 with first 4 bits */
+	{ 0x30, 0, 0, 0x00000000 },
+	{ 0x74, 0, 0, 0x00000004 },
+	{ 0x15, 0, 3, 0x00000006 },
+	/* go further 6 bytes ahead and compare ICMPv6 type 0x3a */
+	{ 0x30, 0, 0, 0x00000006},
+	{ 0x15, 0, 1, 0x0000003a},
+	/* return */
+	{ 0x6, 0, 0, 0x00000500}, /* PASS - return upto 1280 bytes */
+	{ 0x6, 0, 0, 0x00000000}  /* FAIL - return no bytes */
+};
 static const struct sock_fprog bpf_prog = {sizeof(bpf) / sizeof(*bpf), bpf};
+static const struct sock_fprog bpf_prog_ns_na = {sizeof(bpf_ns_na) / sizeof(*bpf_ns_na), bpf_ns_na};
 static struct netevent_handler ndp_netevent_handler = { .cb = ndp_netevent_cb, };
 
 /* Initialize NDP-proxy */
@@ -65,6 +89,255 @@ int ndp_init(void)
 	return ret;
 }
 
