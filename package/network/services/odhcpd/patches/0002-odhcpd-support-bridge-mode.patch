 	}
 
+	/* Handle STA Bridge mode situation, relay received NS to master intrfaces */
+	if(iface->ndp == MODE_RELAY && iface->sta_bridge_mode == true && !ns_is_dad)
+	{
+		//bridge case, forward the NS in case same IPv6 subnet scenario.
+		syslog(LOG_DEBUG, "bridge#handle_solicit: enter check whether the NS need forward");
+		if (iface->addr6 == NULL)
+		{
+			syslog(LOG_DEBUG, "bridge#handle_solicit: iface %s don't have IPv6 address", iface->name);
+			return;
+		}
+
+		bool isAnyAddrSame=false;
+		size_t i=0;
+
+		syslog(LOG_DEBUG, "bridge#handle_solicit: check iface %s", iface->name);
+		syslog(LOG_DEBUG, "bridge#handle_solicit: src %s",
+			inet_ntop(AF_INET6, &ip6->ip6_src, ipbuf, sizeof(ipbuf))),
+		syslog(LOG_DEBUG, "bridge#handle_solicit: dst %s",
+		inet_ntop(AF_INET6, &ip6->ip6_dst, ipbuf, sizeof(ipbuf)));
+
+		for(i=0; i<iface->addr6_len; i++)
+		{
+			syslog(LOG_DEBUG, "bridge#handle_solicit: local address %s",
+				inet_ntop(AF_INET6, &iface->addr6[i].addr.in6, ipbuf, sizeof(ipbuf)));
+
+			if (!memcmp(&ip6->ip6_src, &(iface->addr6[i].addr.in6), sizeof(ip6->ip6_src)) ||
+				!memcmp(&ip6->ip6_dst, &(iface->addr6[i].addr.in6), sizeof(ip6->ip6_dst)))
+			{
+				isAnyAddrSame=true;
+				syslog(LOG_DEBUG, "bridge#handle_solicit: neighbor message is targeted self,"
+								"no need forward for bridge");
+				break;
+			}
+		}
+
+		if (!isAnyAddrSame)
+		{
+			//if the NS/NA target is not self, then relay the message;
+			relay_ns_na(iface, addr, ip6, data, len);
+			syslog(LOG_DEBUG, "forwarding neighbor message for bridge case");
+		}
+		return;
+	}
+
 	/* Catch global-addressed NS and answer them manually.
 	 * The kernel won't answer these and cannot route them either. */
 	if (!IN6_IS_ADDR_MULTICAST(&ip6->ip6_dst) &&
