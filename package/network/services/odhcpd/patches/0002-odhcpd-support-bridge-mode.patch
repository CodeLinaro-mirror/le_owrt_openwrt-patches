+			if (hdr->icmp6_type == ND_ROUTER_SOLICIT)
+			{
+				syslog(LOG_DEBUG, "handle_icmpv6: forward RS for ");
+				send_RS_withUnspecifiedSrc(iface, addr);
+			}
+		}
+		else
 		if (hdr->icmp6_type == ND_ROUTER_SOLICIT && !iface->master) {
 			struct interface *c;
 
@@ -918,7 +997,7 @@ static void handle_icmpv6(void *addr, void *data, size_t len,
 
 				forward_router_solicitation(c);
 			}
-		} else if (hdr->icmp6_type == ND_ROUTER_ADVERT && iface->master)
+		} else if (hdr->icmp6_type == ND_ROUTER_ADVERT && (iface->master || iface->sta_bridge_mode))
 			forward_router_advertisement(iface, data, len);
 	}
