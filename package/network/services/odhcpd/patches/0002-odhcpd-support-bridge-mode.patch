+static int send_ns_na(struct interface *iface,
+							struct sockaddr_ll *ll,
+							struct ip6_hdr *ip6,
+							uint8_t *data_buf, uint64_t data_buf_length,
+							struct sockaddr_in6* destn)
+{
+	char ipbuffer[INET6_ADDRSTRLEN];
+	int packet_size = 0;
+	struct nd_opt_hdr *opt_hdr;
+
+	/* NULL checks */
+	if (iface == NULL || ll == NULL || ip6 == NULL || (data_buf_length == 0 || data_buf == NULL) || destn == NULL)
+		return -1;
+
+	/** NOTE: Total bytes to copy from the received raw message is the sum of IPv6 header length and ICMPv6 header length.
+	 *	As per spec: IPv6 header length is 40 bytes. And IPv6 header contains a Payload length field indicating ICMPv6 header length
+	 *	plus optional parameters */
+	uint16_t total_bytes_to_copy = data_buf_length - sizeof(struct ip6_hdr);
+	syslog(LOG_DEBUG, "Total bytes to copy from the received raw message: %d",total_bytes_to_copy);
+
+	uint8_t data_buf_copied[total_bytes_to_copy];
+	for (int i = 0; i < total_bytes_to_copy; i++)
+	{
+		data_buf_copied[i] = data_buf[sizeof(struct ip6_hdr) + i];
+//		syslog(LOG_DEBUG, "bridge#send_ns_na: 0x%x", data_buf_copied[i]);
+	}
+
+	packet_size = sizeof(struct nd_neighbor_solicit);
+	opt_hdr = (struct nd_opt_hdr *) (data_buf + sizeof(struct ip6_hdr) + sizeof(struct nd_neighbor_solicit));
+
+	while(opt_hdr != NULL && opt_hdr->nd_opt_len != 0)
+	{
+		packet_size += (opt_hdr->nd_opt_len * 8);
+
+		if (opt_hdr->nd_opt_type == ND_OPT_SOURCE_LINKADDR ||  //for NS case
+			opt_hdr->nd_opt_type == ND_OPT_TARGET_LINKADDR)    //for NA case
+		{
+			struct ether_addr bridge_mac_addr, *target_mac_addr;
+			target_mac_addr = (struct ether_addr*) (data_buf_copied + (packet_size - 6));
+			odhcpd_get_mac(iface, (uint8_t*)&bridge_mac_addr);
+			syslog(LOG_ERR, "original options ll addr:%s", ether_ntoa(target_mac_addr));
+			syslog(LOG_ERR, "replaced with bridge MAC: %s", ether_ntoa(&bridge_mac_addr));
+			memcpy(target_mac_addr, &bridge_mac_addr, 6);
+			break;
+		}
+
+		opt_hdr = (struct nd_opt_hdr *) (opt_hdr + opt_hdr->nd_opt_len);
+	}
+	/* Construct iovector */
+	struct iovec iov = { data_buf_copied, sizeof(data_buf_copied) };
+
+	struct msghdr msg1 = {
+		.msg_name = (void *) destn,
+		.msg_namelen = sizeof(*destn),
+		.msg_iov = &iov,
+		.msg_iovlen = 1
+	};
+	inet_ntop(AF_INET6, destn, ipbuffer, sizeof(ipbuffer));
+	ssize_t sent = sendmsg(iface->ndp_ping_fd, &msg1, MSG_DONTWAIT);
+	if (sent < 0)
+	{
+		syslog(LOG_ERR, "Failed to relay NS or NA to %s%%%s@%s (%m); errno: %d(fd=%d)",
+				ipbuffer, iface->name, iface->ifname, errno, iface->ndp_ping_fd);
+		return -1;
+	}
+	else
+	{
+		syslog(LOG_DEBUG, "Sent %zd bytes to %s%%%s@%s",
+				sent, ipbuffer, iface->name, iface->ifname);
+		return 0;
+	}
+
+}
+
+/* Relay neighbor solicitation */
+static void relay_ns_na(struct interface *iface,
+			struct sockaddr_ll *ll,
+			struct ip6_hdr *ip6,
+			uint8_t *data_buf, uint64_t data_buf_length)
+{
+	char ipbuffer[INET6_ADDRSTRLEN];
+
+	/* NULL checks */
+	if (iface == NULL || ll == NULL || ip6 == NULL || (data_buf_length == 0 || data_buf == NULL))
+		return;
+
+	struct nd_neighbor_solicit *ns_header = (struct nd_neighbor_solicit *)((struct icmp6_hdr *)(ip6 + 1));
+
+	if (ns_header->nd_ns_hdr.icmp6_type == ND_NEIGHBOR_SOLICIT)
+	{
+		struct proxy_data_info* new_proxy_item;
+
+		syslog(LOG_DEBUG, "need relay NS message");
+
+		new_proxy_item = malloc(sizeof(struct proxy_data_info));
+		new_proxy_item->dst_ipv6_addr=ns_header->nd_ns_target;
+		new_proxy_item->src_ipv6_addr=ip6->ip6_src;
+
+		struct sockaddr_in6 destn = { .sin6_family = AF_INET6, .sin6_addr = ip6->ip6_dst, .sin6_scope_id = iface->ifindex };
+
+		inet_ntop(AF_INET6, &ip6->ip6_dst, ipbuffer, sizeof(ipbuffer));
+		syslog(LOG_DEBUG, "relay NS message to %s", ipbuffer);
+
+		if(send_ns_na(iface, ll, ip6, data_buf, data_buf_length, &destn) == 0)
+		{
+			list_add(&new_proxy_item->head, &proxy_data_info_list_head);
+		}
+	}
+	else if (ns_header->nd_ns_hdr.icmp6_type == ND_NEIGHBOR_ADVERT)
+	{
+		struct list_head *pos, *q;
+		struct proxy_data_info *entry;
+		syslog(LOG_DEBUG, "begin relay NA message");
+
+		list_for_each_safe(pos, q, &proxy_data_info_list_head) {
+			entry = list_entry(pos, struct proxy_data_info, head);
+			if (memcmp(&entry->dst_ipv6_addr, &ip6->ip6_src , sizeof(struct in6_addr)) == 0)
+			{
+				struct sockaddr_in6 destn =
+					{ 	.sin6_family = AF_INET6,
+						.sin6_addr = entry->src_ipv6_addr,
+						.sin6_scope_id = iface->ifindex
+					};
+				inet_ntop(AF_INET6, &entry->src_ipv6_addr, ipbuffer, sizeof(ipbuffer));
+				syslog(LOG_DEBUG, "relay NA message to %s", ipbuffer);
+				send_ns_na(iface, ll, ip6, data_buf, data_buf_length, &destn);
+				list_del(pos);
+				free(entry);
+			}
+		}
+
+	}
+}
