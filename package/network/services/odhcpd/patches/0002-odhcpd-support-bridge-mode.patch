+/*send RS with unspecified src to request RA multicast packet */
+static int send_RS_withUnspecifiedSrc(struct interface *iface, struct sockaddr_in6 *from)
+{
+	int sockfd;
+	struct sockaddr_in6 dst_addr;
+	struct ip6_hdr ip6_hdr;
+	struct icmp6_hdr icmp6_hdr;
+	char buffer[1024];
+	struct in6_addr ip6_unspecified_addr;
+
+#define SRC_ADDR "::"
+#define DST_ADDR "ff02::2"
+
+	inet_pton(AF_INET6, SRC_ADDR, &ip6_unspecified_addr);
+
+	if(memcmp(&from->sin6_addr, &ip6_unspecified_addr, sizeof(struct in6_addr)) == 0)
+	{
+		syslog(LOG_ERR, "ignore RS with unspecifed src");
+		return 0;
+	}
+
+	sockfd = socket(AF_INET6, SOCK_RAW, IPPROTO_RAW);
+	if (sockfd < 0) {
+		syslog(LOG_INFO, "create raw socket error:%m");
+		return (-1);
+	}
+
+	if (setsockopt(sockfd, SOL_SOCKET, SO_BINDTODEVICE,
+			iface->ifname, strlen(iface->ifname)) < 0) {
+		syslog(LOG_ERR, "setsockopt(SO_BINDTODEVICE): %m");
+		return -1;
+	}
+
+
+	memset(&dst_addr, 0, sizeof(dst_addr));
+	dst_addr.sin6_family = AF_INET6;
+	dst_addr.sin6_port = 0;
+	inet_pton(AF_INET6, DST_ADDR, &dst_addr.sin6_addr);
+
+	memset(&ip6_hdr, 0, sizeof(ip6_hdr));
+	ip6_hdr.ip6_flow = htonl((6 << 28) | (0 << 20) | 0);
+	ip6_hdr.ip6_plen = htons(sizeof(icmp6_hdr));
+	ip6_hdr.ip6_nxt = IPPROTO_ICMPV6;
+	ip6_hdr.ip6_hlim = 255;
+	inet_pton(AF_INET6, SRC_ADDR, &ip6_hdr.ip6_src);
+	inet_pton(AF_INET6, DST_ADDR, &ip6_hdr.ip6_dst);
+
+	memset(&icmp6_hdr, 0, sizeof(icmp6_hdr));
+	icmp6_hdr.icmp6_type = ND_ROUTER_SOLICIT;
+	icmp6_hdr.icmp6_code = 0;
+	icmp6_hdr.icmp6_cksum = 0xb87b; //hardcode validated value since we have fixed address/message
+
+	memset(buffer, 0, sizeof(buffer));
+	memcpy(buffer, &ip6_hdr, sizeof(ip6_hdr));
+	memcpy(buffer + sizeof(ip6_hdr), &icmp6_hdr, sizeof(icmp6_hdr));
+
+	if (sendto(sockfd, buffer, sizeof(ip6_hdr) + sizeof(icmp6_hdr), 0, (struct sockaddr *)&dst_addr, sizeof(dst_addr)) < 0) {
+		syslog(LOG_INFO, "send to failure:%m");
+		return -1;
+	}
+
+	syslog(LOG_INFO, "send RS with unspecified src address successfully.");
+
+	close(sockfd);
+	return 0;
+}
