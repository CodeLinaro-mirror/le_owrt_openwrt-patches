 static int send_router_advert(struct interface *iface, const struct in6_addr *from)
 {
@@ -909,6 +979,15 @@ static void handle_icmpv6(void *addr, void *data, size_t len,
 		if (hdr->icmp6_type == ND_ROUTER_SOLICIT)
