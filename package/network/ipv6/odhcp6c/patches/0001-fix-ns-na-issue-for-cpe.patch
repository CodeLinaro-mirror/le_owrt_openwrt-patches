+	if (if_indextoname(ifindex, ifname)) {
+		syslog(LOG_INFO, "[ODHCP6C_DEBUG] Calling check_and_trigger_ns_odhcp6c() from dhcpv6_handle_reply()");
+		check_and_trigger_ns_odhcp6c(opt, end, ifname);
