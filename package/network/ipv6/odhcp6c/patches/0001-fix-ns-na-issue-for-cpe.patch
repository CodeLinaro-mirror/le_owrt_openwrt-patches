@@ -1070,8 +1342,20 @@ static int dhcpv6_handle_reply(enum dhcpv6_msg orig, _unused const int rc,
 	unsigned int updated_IAs = 0;
 	bool handled_status_codes[_DHCPV6_Status_Max] = { false, };
 
