+// DHCPv6 NS Fix: Configuration helper functions
+
+// Read integer value from UCI config using popen
+// Uses 'uci get' command to read configuration without library dependency
+static int uci_get_int_popen(const char *config_path, int default_value)
+{
+	FILE *fp;
+	char cmd[256];
+	char result[32];
+	int value = default_value;
+
+	// Build uci get command
+	snprintf(cmd, sizeof(cmd), "uci get %s 2>/dev/null", config_path);
+
+	// Execute command and read output
+	fp = popen(cmd, "r");
+	if (fp == NULL) {
+		syslog(LOG_DEBUG, "[ODHCP6C_CONFIG] Failed to execute: %s", cmd);
+		return default_value;
+	}
+
+	// Read the result (single line expected)
+	if (fgets(result, sizeof(result), fp) != NULL) {
+		// Remove trailing newline
+		result[strcspn(result, "\n")] = '\0';
+		
+		// Convert to integer
+		value = atoi(result);
+		syslog(LOG_DEBUG, "[ODHCP6C_CONFIG] Read %s = %d", config_path, value);
+	} else {
+		syslog(LOG_DEBUG, "[ODHCP6C_CONFIG] Option %s not found or empty", config_path);
+	}
+
+	pclose(fp);
+	return value;
+}
+
+// Check if NS probe is enabled via UCI
+static bool is_ns_probe_enabled(void)
+{
+	int probe_ns;
+
+	// Read dhcp.odhcpd.probe_ns using popen-based UCI access
+	// Returns 1 if NS probe enabled, 0 if disabled, 0 on error (fail-safe)
+	probe_ns = uci_get_int_popen("dhcp.odhcpd.probe_ns", 0);
+
+	syslog(LOG_INFO, "[ODHCP6C_CONFIG] NS probe check: dhcp.odhcpd.probe_ns=%d", probe_ns);
+
+	return (probe_ns == 1);
+}
+
+// DHCPv6 NS Fix: Helper function implementations
+
+// Extract MAC address from DUID-LL or DUID-LLT
+static bool extract_mac_from_duid(const uint8_t *duid, size_t duid_len, uint8_t mac[6])
+{
+	if (duid_len < 8)
+		return false;
+
+	uint16_t duid_type = (duid[0] << 8) | duid[1];
+
+	// DUID-LLT (Type 1): 2 bytes type + 2 bytes hw type + 4 bytes time + 6 bytes MAC = 14 bytes
+	if (duid_type == 1 && duid_len >= 14) {
+		memcpy(mac, duid + 8, 6);
+		return true;
+	}
+
+	// DUID-LL (Type 3): 2 bytes type + 2 bytes hw type + 6 bytes MAC = 10 bytes minimum
+	if (duid_type == 3 && duid_len >= 10) {
+		memcpy(mac, duid + 4, 6);
+		return true;
+	}
+
+	return false;
+}
+
+// Convert MAC address to IPv6 link-local address using EUI-64
+static void mac_to_ipv6_linklocal(const uint8_t mac[6], struct in6_addr *ll_addr)
+{
+	memset(ll_addr, 0, sizeof(*ll_addr));
+	ll_addr->s6_addr[0] = 0xfe;
+	ll_addr->s6_addr[1] = 0x80;
+
+	// EUI-64: Insert 0xfffe in the middle and flip U/L bit
+	ll_addr->s6_addr[8] = mac[0] ^ 0x02;
+	ll_addr->s6_addr[9] = mac[1];
+	ll_addr->s6_addr[10] = mac[2];
+	ll_addr->s6_addr[11] = 0xff;
+	ll_addr->s6_addr[12] = 0xfe;
+	ll_addr->s6_addr[13] = mac[3];
+	ll_addr->s6_addr[14] = mac[4];
+	ll_addr->s6_addr[15] = mac[5];
+}
+
+// Send Neighbor Solicitation using raw ICMPv6 socket
+static void send_neighbor_solicitation(const struct in6_addr *target, const char *ifname)
+{
+	int sock;
+	int if_index = 0;
+	struct sockaddr_in6 dest;
+	struct {
+		struct nd_neighbor_solicit ns;
+		struct nd_opt_hdr opt_hdr;
+		uint8_t src_mac[6];
+	} __attribute__((packed)) ns_packet;
+	char addr_str[INET6_ADDRSTRLEN];
+
+	inet_ntop(AF_INET6, target, addr_str, sizeof(addr_str));
+	syslog(LOG_INFO, "[ODHCP6C_NS_DEBUG] === NS TRIGGER START ===");
+	syslog(LOG_INFO, "[ODHCP6C_NS_DEBUG] Target: %s on interface %s", addr_str, ifname);
+
+	sock = socket(AF_INET6, SOCK_RAW, IPPROTO_ICMPV6);
+	if (sock < 0) {
+		syslog(LOG_ERR, "DHCPv6 NS Fix: Failed to create ICMPv6 socket: %m");
+		syslog(LOG_ERR, "[ODHCP6C_NS_DEBUG] Socket creation failed: %m");
+		return;
+	}
+	syslog(LOG_INFO, "[ODHCP6C_NS_DEBUG] ICMPv6 socket created successfully (fd=%d)", sock);
+
+	// Tell the kernel to compute the ICMPv6 checksum at offset 2
+	// Without this, the checksum remains 0 and the packet may be dropped
+	int chksum_offset = 2;
+	if (setsockopt(sock, IPPROTO_IPV6, IPV6_CHECKSUM, &chksum_offset, sizeof(chksum_offset)) < 0) {
+		syslog(LOG_ERR, "DHCPv6 NS Fix: Failed to set IPV6_CHECKSUM: %m");
+		syslog(LOG_ERR, "[ODHCP6C_NS_DEBUG] Failed to set IPV6_CHECKSUM socket option: %m");
+		close(sock);
+		return;
+	}
+	syslog(LOG_INFO, "[ODHCP6C_NS_DEBUG] IPV6_CHECKSUM socket option set (offset=%d)", chksum_offset);
+
+	// Bind to interface
+	if (setsockopt(sock, SOL_SOCKET, SO_BINDTODEVICE, ifname, strlen(ifname)) < 0) {
+		syslog(LOG_ERR, "DHCPv6 NS Fix: Failed to bind to %s: %m", ifname);
+		syslog(LOG_ERR, "[ODHCP6C_NS_DEBUG] Failed to bind socket to interface %s", ifname);
+		close(sock);
+		return;
+	}
+	syslog(LOG_INFO, "[ODHCP6C_NS_DEBUG] Socket bound to interface %s", ifname);
+
+	// Build NS packet
+	memset(&ns_packet, 0, sizeof(ns_packet));
+	ns_packet.ns.nd_ns_type = ND_NEIGHBOR_SOLICIT;
+	ns_packet.ns.nd_ns_code = 0;
+	ns_packet.ns.nd_ns_cksum = 0;
+	ns_packet.ns.nd_ns_reserved = 0;
+	memcpy(&ns_packet.ns.nd_ns_target, target, sizeof(struct in6_addr));
+
+	// Add source link-layer address option (type 1)
+	ns_packet.opt_hdr.nd_opt_type = ND_OPT_SOURCE_LINKADDR;
+	ns_packet.opt_hdr.nd_opt_len = 1; // 8 bytes
+
+	// Get source MAC and interface index from interface
+	struct ifreq ifr;
+	memset(&ifr, 0, sizeof(ifr));
+	strlcpy(ifr.ifr_name, ifname, IFNAMSIZ - 1);
+	
+	// Get interface index for sin6_scope_id (required for link-local addresses)
+	if (ioctl(sock, SIOCGIFINDEX, &ifr) == 0) {
+		if_index = ifr.ifr_ifindex;
+		syslog(LOG_INFO, "[ODHCP6C_NS_DEBUG] Interface %s has index %d", ifname, if_index);
+	} else {
+		syslog(LOG_ERR, "[ODHCP6C_NS_DEBUG] Failed to get interface index for %s: %m", ifname);
+	}
+	
+	// Get source MAC address
+	if (ioctl(sock, SIOCGIFHWADDR, &ifr) == 0) {
+		memcpy(ns_packet.src_mac, ifr.ifr_hwaddr.sa_data, 6);
+	}
+
+	// Destination: unicast link-local address (not solicited-node multicast)
+	// In relay scenarios, we need unicast NS to force direct response
+	memset(&dest, 0, sizeof(dest));
+	dest.sin6_family = AF_INET6;
+	dest.sin6_addr = *target;  // Use target address directly (fe80::...)
+	dest.sin6_scope_id = if_index;  // Required for link-local addresses
+
+	syslog(LOG_INFO, "[ODHCP6C_NS_DEBUG] Sending NS packet (%zu bytes)", sizeof(ns_packet));
+	
+	if (sendto(sock, &ns_packet, sizeof(ns_packet), 0,
+	           (struct sockaddr *)&dest, sizeof(dest)) < 0) {
+		syslog(LOG_ERR, "DHCPv6 NS Fix: Failed to send NS: %m");
+		syslog(LOG_ERR, "[ODHCP6C_NS_DEBUG] sendto() failed: %m");
+	} else {
+		syslog(LOG_INFO, "[ODHCP6C_NS_DEBUG] NS packet sent successfully");
+		syslog(LOG_INFO, "[ODHCP6C_NS_DEBUG] === NS TRIGGER COMPLETE ===");
+	}
+
+	close(sock);
+}
+
+// Main function to check and trigger NS
+static void check_and_trigger_ns_odhcp6c(const void *opt, const void *end,
+                                          const char *ifname)
+{
+	uint16_t otype, olen;
+	uint8_t *odata;
+	uint8_t mac[6];
+	struct in6_addr ll_addr;
+	char mac_str[18], addr_str[INET6_ADDRSTRLEN];
+
+	syslog(LOG_INFO, "[ODHCP6C_DEBUG] check_and_trigger_ns_odhcp6c() called on interface %s", ifname);
+
+	// CONDITIONAL TRIGGER: Only proceed if NS probe is enabled via UCI
+	if (!is_ns_probe_enabled()) {
+		syslog(LOG_INFO, "[ODHCP6C_DEBUG] NS probe disabled (dhcp.odhcpd.probe_ns != 1), skipping NS trigger");
+		return;
+	}
+
+	dhcpv6_for_each_option(opt, end, otype, olen, odata) {
+		if (otype == DHCPV6_OPT_SERVERID && extract_mac_from_duid(odata, olen, mac)) {
+			snprintf(mac_str, sizeof(mac_str), "%02x:%02x:%02x:%02x:%02x:%02x",
+			         mac[0], mac[1], mac[2], mac[3], mac[4], mac[5]);
+			mac_to_ipv6_linklocal(mac, &ll_addr);
+			inet_ntop(AF_INET6, &ll_addr, addr_str, sizeof(addr_str));
+		syslog(LOG_INFO, "DHCPv6 NS Fix: Server ID found - MAC: %s, LL: %s", mac_str, addr_str);
+		syslog(LOG_INFO, "DHCPv6 NS Fix: Triggering NS for server %s on %s", addr_str, ifname);
+		syslog(LOG_INFO, "[ODHCP6C_DEBUG] Extracted server MAC: %s, Link-local: %s", mac_str, addr_str);
+
+		// Send NS to trigger kernel NUD and update neighbor cache asynchronously
+		// The kernel will process the NA response and update the neighbor cache independently
+		// No need to block DHCPv6 processing - NS/NA exchange happens in parallel
+		send_neighbor_solicitation(&ll_addr, ifname);
+		return;
+		}
+	}
+	syslog(LOG_INFO, "[ODHCP6C_DEBUG] No SERVERID found in DHCPv6 options");
+}
+
