+static void netlink_parse_trigger(struct netlink_parse_ctx *ctx,
+				   const struct location *loc,
+				   const struct nftnl_expr *nle)
+{
+	struct stmt *stmt;
+	struct expr *trigger_ports, *forward_ports;
+	enum nft_registers reg1, reg2;
+
+	stmt = trigger_stmt_alloc(loc);
+	stmt->trigger.mode = nftnl_expr_get_u32(nle,
+							NFTNL_EXPR_TRIGGER_MODE);
+	stmt->trigger.trigger_proto = nftnl_expr_get_u32(nle,
+							NFTNL_EXPR_TRIGGER_TPROTO);
+	stmt->trigger.forward_proto = nftnl_expr_get_u32(nle,
+							NFTNL_EXPR_TRIGGER_FPROTO);
+	stmt->trigger.timer = nftnl_expr_get_u32(nle,
+							NFTNL_EXPR_TRIGGER_TIMER);
+
+	reg1 = netlink_parse_register(nle, NFTNL_EXPR_TRIGGER_TPORTS_MIN);
+	if (reg1) {
+		trigger_ports = netlink_get_register(ctx, loc, reg1);
+		if (trigger_ports == NULL) {
+			netlink_error(ctx, loc,
+				      "TRIGGER statement has no trigger_ports expression");
+			goto out_err;
+		}
+
+		expr_set_type(trigger_ports, &inet_service_type, BYTEORDER_BIG_ENDIAN);
+		stmt->trigger.trigger_ports = trigger_ports;
+	}
+
+	reg2 = netlink_parse_register(nle, NFTNL_EXPR_TRIGGER_TPORTS_MAX);
+	if(reg2 && reg2 != reg1) {
+		trigger_ports = netlink_get_register(ctx, loc, reg2);
+		if (trigger_ports == NULL) {
+			netlink_error(ctx, loc,
+				      "TRIGGER statement has no trigger_ports expression");
+			goto out_err;
+		}
+
+		expr_set_type(trigger_ports, &inet_service_type, BYTEORDER_BIG_ENDIAN);
+		if (stmt->trigger.trigger_ports != NULL)
+			trigger_ports = range_expr_alloc(loc, stmt->trigger.trigger_ports, trigger_ports);
+		stmt->trigger.trigger_ports = trigger_ports;
+	}
+
+	reg1 = netlink_parse_register(nle, NFTNL_EXPR_TRIGGER_FPORTS_MIN);
+	if (reg1) {
+		forward_ports = netlink_get_register(ctx, loc, reg1);
+		if (forward_ports == NULL) {
+			netlink_error(ctx, loc,
+				      "TRIGGER statement has no forward_ports expression");
+			goto out_err;
+		}
+
+		expr_set_type(forward_ports, &inet_service_type, BYTEORDER_BIG_ENDIAN);
+		stmt->trigger.forward_ports = forward_ports;
+	}
+
+	reg2 = netlink_parse_register(nle, NFTNL_EXPR_TRIGGER_FPORTS_MAX);
+	if(reg2 && reg2 != reg1) {
+		forward_ports = netlink_get_register(ctx, loc, reg2);
+		if (forward_ports == NULL) {
+			netlink_error(ctx, loc,
+				      "TRIGGER statement has no forward_ports expression");
+			goto out_err;
+		}
+
+		expr_set_type(forward_ports, &inet_service_type, BYTEORDER_BIG_ENDIAN);
+		if (stmt->trigger.forward_ports != NULL)
+			forward_ports = range_expr_alloc(loc, stmt->trigger.forward_ports, forward_ports);
+		stmt->trigger.forward_ports = forward_ports;
+	}
+
+	ctx->stmt = stmt;
+	return;
+out_err:
+	stmt_free(stmt);
+}
+
 static void netlink_parse_synproxy(struct netlink_parse_ctx *ctx,
 				   const struct location *loc,
 				   const struct nftnl_expr *nle)
@@ -1929,6 +2009,7 @@ static const struct expr_handler netlink_parsers[] = {
