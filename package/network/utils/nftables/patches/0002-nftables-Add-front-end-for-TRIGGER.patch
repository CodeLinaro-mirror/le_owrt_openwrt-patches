diff --git a/src/evaluate.c b/src/evaluate.c
index d4439728..836d39a6 100644
--- a/src/evaluate.c
+++ b/src/evaluate.c
@@ -4208,6 +4208,68 @@ static int stmt_evaluate_nattype(struct eval_ctx *ctx, struct stmt *stmt)
 	return 0;
 }
 
+static int trigger_evaluate_proto(struct eval_ctx *ctx, struct stmt *stmt,
+							uint16_t proto)
+{
+	switch (proto) {
+	case IPPROTO_TCP:
+	case IPPROTO_UDP:
+	/* Dummy protcol resp of ALL. */
+	case 0:
+		return 0;
+	default:
+		return stmt_error(ctx, stmt, "TRIGGER protocol must be TCP/UDP/ALL!");
+	}
+}
+
+static int trigger_evaluate_ports(struct eval_ctx *ctx, struct stmt *stmt,
+							struct expr **expr)
+{
+	int err;
+	err = stmt_evaluate_arg(ctx, stmt,
+				&inet_service_type, 2 * BITS_PER_BYTE,
+				BYTEORDER_BIG_ENDIAN, expr);
+	if (err < 0)
+		return err;
+
+	return 0;
+}
+
+static int stmt_evaluate_trigger(struct eval_ctx *ctx, struct stmt *stmt)
+{
+	int err;
+
+	switch (stmt->trigger.mode) {
+	case TRIGGER_MODE_DNAT:
+	case TRIGGER_MODE_FORWARD_IN:
+	case TRIGGER_MODE_FORWARD_OUT:
+		break;
+	default:
+		return stmt_error(ctx, stmt, "TRIGGER must declare one mode!");
+	}
+
+	err = trigger_evaluate_proto(ctx, stmt, stmt->trigger.trigger_proto);
+	if (err < 0)
+		return err;
+	err = trigger_evaluate_proto(ctx, stmt, stmt->trigger.forward_proto);
+	if (err < 0)
+		return err;
+
+	if (stmt->trigger.trigger_ports != NULL) {
+		err = trigger_evaluate_ports(ctx, stmt, &stmt->trigger.trigger_ports);
+		if (err < 0)
+			return err;
+	}
+
+	if (stmt->trigger.forward_ports != NULL) {
+		err = trigger_evaluate_ports(ctx, stmt, &stmt->trigger.forward_ports);
+		if (err < 0)
+			return err;
+	}
+	stmt->flags |= STMT_F_TERMINAL;
+	return 0;
+}
+
 static int stmt_evaluate_tproxy(struct eval_ctx *ctx, struct stmt *stmt)
 {
 	struct proto_ctx *pctx = eval_proto_ctx(ctx);
@@ -4740,6 +4802,8 @@ int stmt_evaluate(struct eval_ctx *ctx, struct stmt *stmt)
 		return stmt_evaluate_nat(ctx, stmt);
 	case STMT_NATTYPE:
 		return stmt_evaluate_nattype(ctx, stmt);
+	case STMT_TRIGGER:
+		return stmt_evaluate_trigger(ctx, stmt);
 	case STMT_TPROXY:
 		return stmt_evaluate_tproxy(ctx, stmt);
 	case STMT_QUEUE:
