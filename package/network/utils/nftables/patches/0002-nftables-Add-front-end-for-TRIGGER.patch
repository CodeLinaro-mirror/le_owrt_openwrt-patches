+json_t *trigger_stmt_json(const struct stmt *stmt, struct output_ctx *octx)
+{
+	json_t *root = json_object();
+	const char *mode = NULL;
+
+	switch (stmt->trigger.mode) {
+	case TRIGGER_MODE_DNAT:
+		mode = "dnat";
+		break;
+	case TRIGGER_MODE_FORWARD_IN:
+		mode = "forward_in";
+		break;
+	case TRIGGER_MODE_FORWARD_OUT:
+		mode = "forward_in";
+		break;
+	}
+
+	if (mode)
+		json_object_set_new(root, "mode", json_string(mode));
+
+	if (stmt->trigger.trigger_proto)
+		json_object_set_new(root, "trigger_proto",
+					json_string(tproto2str(stmt->trigger.trigger_proto)));
+
+	if (stmt->trigger.forward_proto)
+		json_object_set_new(root, "forward_proto",
+					json_string(tproto2str(stmt->trigger.forward_proto)));
+
+	if (stmt->trigger.timer)
+		json_object_set_new(root, "timer",
+					json_integer(stmt->trigger.timer));
+
+	if (stmt->trigger.trigger_ports)
+		json_object_set_new(root, "trigger_ports",
+				    expr_print_json(stmt->trigger.trigger_ports, octx));
+
+	if (stmt->trigger.forward_ports)
+		json_object_set_new(root, "forward_ports",
+				    expr_print_json(stmt->trigger.forward_ports, octx));
+
+	return json_pack("{s:o}", "TRIGGER", root);
+}
