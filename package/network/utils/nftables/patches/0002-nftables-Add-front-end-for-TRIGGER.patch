+const char *trigger_mode2str(enum trigger_modes mode)
+{
+	static const char * const nattype_modes[] = {
+		[TRIGGER_MODE_DNAT] 			 = "dnat",
+		[TRIGGER_MODE_FORWARD_IN]  = "forward_in",
+		[TRIGGER_MODE_FORWARD_OUT] = "forward_out",
+	};
+
+	return nattype_modes[mode];
+}
+
+const char *trigger_proto2str(uint32_t proto)
+{
+	switch (proto) {
+		case IPPROTO_TCP:
+			return "tcp";
+		case IPPROTO_UDP:
+			return "udp";
+		case 0:
+			return "all";
+		default:
+			break;
+	}
+	return "unknown";
+}
+
+static void trigger_stmt_print(const struct stmt *stmt, struct output_ctx *octx)
+{
+	nft_print(octx, "TRIGGER %s", trigger_mode2str(stmt->trigger.mode));
+	nft_print(octx, " trigger_proto %s", trigger_proto2str(stmt->trigger.trigger_proto));
+	nft_print(octx, " forward_proto %s", trigger_proto2str(stmt->trigger.forward_proto));
+	nft_print(octx, " timer %d", stmt->trigger.timer);
+
+	if (stmt->trigger.trigger_ports) {
+		nft_print(octx, " ");
+		if (stmt->trigger.trigger_ports->etype == EXPR_VALUE) {
+			nft_print(octx, "trigger_port ");
+			expr_print(stmt->trigger.trigger_ports, octx);
+		} else if (stmt->trigger.trigger_ports->etype == EXPR_RANGE) {
+			nft_print(octx, "trigger_ports ");
+			expr_print(stmt->trigger.trigger_ports->left, octx);
+			nft_print(octx, "-");
+			expr_print(stmt->trigger.trigger_ports->right, octx);
+		}
+		else {
+			expr_print(stmt->trigger.trigger_ports, octx);
+		}
+	}
+
+	if (stmt->trigger.forward_ports) {
+		nft_print(octx, " ");
+		if (stmt->trigger.forward_ports->etype == EXPR_VALUE) {
+			nft_print(octx, "forward_ports ");
+			expr_print(stmt->trigger.forward_ports, octx);
+		} else if (stmt->trigger.forward_ports->etype == EXPR_RANGE) {
+			nft_print(octx, "forward_ports ");
+			expr_print(stmt->trigger.forward_ports->left, octx);
+			nft_print(octx, "-");
+			expr_print(stmt->trigger.forward_ports->right, octx);
+		}
+		else {
+			expr_print(stmt->trigger.forward_ports, octx);
+		}
+	}
+}
+
+static void trigger_stmt_destroy(struct stmt *stmt)
+{
+	expr_free(stmt->trigger.trigger_ports);
+	expr_free(stmt->trigger.forward_ports);
+}
+
+static const struct stmt_ops trigger_stmt_ops = {
+	.type			= STMT_TRIGGER,
+	.name			= "TRIGGER",
+	.print		= trigger_stmt_print,
+	.json			= trigger_stmt_json,
+	.destroy	= trigger_stmt_destroy,
+};
+
+struct stmt *trigger_stmt_alloc(const struct location *loc)
+{
+	struct stmt *stmt = stmt_alloc(loc, &trigger_stmt_ops);
+
+	return stmt;
+}
