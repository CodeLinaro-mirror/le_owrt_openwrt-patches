 close_scope_synproxy	: { scanner_pop_start_cond(nft->scanner, PARSER_SC_STMT_SYNPROXY); }
@@ -3237,6 +3247,7 @@ stmt			:	verdict_stmt
 			|	xt_stmt		close_scope_xt
 			|	objref_stmt
 			| nattype_stmt close_scope_nattype
+			| trigger_stmt close_scope_trigger
 			;
 
 xt_stmt			:	XT	STRING	string
@@ -3734,6 +3745,15 @@ nattype_stmt_arg		: NATTYPE_MODE NATTYPE_DNAT
 			}
 			;
 
+trigger_stmt		: trigger_stmt_alloc trigger_stmt_args
+			;
+
+trigger_stmt_alloc	: TRIGGER
+			{
+				$$ = trigger_stmt_alloc(&@$);
+			}
+			;
+
 tproxy_stmt		:	TPROXY TO stmt_expr
 			{
 				$$ = tproxy_stmt_alloc(&@$);
@@ -4033,6 +4053,63 @@ nat_stmt_args		:	stmt_expr
 			}
 			;
 
+trigger_stmt_args		: trigger_stmt_arg
+			{
+				$<stmt>$	= $<stmt>0;
+			}
