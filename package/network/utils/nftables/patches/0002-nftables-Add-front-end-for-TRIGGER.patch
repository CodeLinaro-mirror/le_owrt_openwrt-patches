+static void netlink_gen_trigger_stmt(struct netlink_linearize_ctx *ctx,
+				 const struct stmt *stmt)
+{
+	struct nftnl_expr *nle;
+	int registers = 0;
+	enum nft_registers tp_min_reg, tp_max_reg;
+	enum nft_registers fp_min_reg, fp_max_reg;
+
+	nle = alloc_nft_expr("TRIGGER");
+	nftnl_expr_set_u32(nle, NFTNL_EXPR_TRIGGER_MODE, stmt->trigger.mode);
+	nftnl_expr_set_u32(nle, NFTNL_EXPR_TRIGGER_TPROTO, stmt->trigger.trigger_proto);
+	nftnl_expr_set_u32(nle, NFTNL_EXPR_TRIGGER_FPROTO, stmt->trigger.forward_proto);
+	nftnl_expr_set_u32(nle, NFTNL_EXPR_TRIGGER_TIMER, stmt->trigger.timer);
+
+	if (stmt->trigger.trigger_ports) {
+		tp_min_reg = get_register(ctx, NULL);
+		registers++;
+
+		if (stmt->trigger.trigger_ports->etype == EXPR_RANGE) {
+			tp_max_reg = get_register(ctx, NULL);
+			registers++;
+			netlink_gen_expr(ctx, stmt->trigger.trigger_ports->left, tp_min_reg);
+			netlink_gen_expr(ctx, stmt->trigger.trigger_ports->right, tp_max_reg);
+			netlink_put_register(nle, NFTNL_EXPR_TRIGGER_TPORTS_MIN,
+							tp_min_reg);
+			netlink_put_register(nle, NFTNL_EXPR_TRIGGER_TPORTS_MAX,
+							tp_max_reg);
+		} else {
+			netlink_gen_expr(ctx, stmt->trigger.trigger_ports, tp_min_reg);
+			netlink_put_register(nle, NFTNL_EXPR_TRIGGER_TPORTS_MIN,
+							tp_min_reg);
+		}
+	}
+
+	if (stmt->trigger.forward_ports) {
+		fp_min_reg = get_register(ctx, NULL);
+		registers++;
+
+		if (stmt->trigger.forward_ports->etype == EXPR_RANGE) {
+			fp_max_reg = get_register(ctx, NULL);
+			registers++;
+
+			netlink_gen_expr(ctx, stmt->trigger.forward_ports->left, fp_min_reg);
+			netlink_gen_expr(ctx, stmt->trigger.forward_ports->right, fp_max_reg);
+			netlink_put_register(nle, NFTNL_EXPR_TRIGGER_FPORTS_MIN,
+							fp_min_reg);
+			netlink_put_register(nle, NFTNL_EXPR_TRIGGER_FPORTS_MAX,
+							fp_max_reg);
+		} else {
+			netlink_gen_expr(ctx, stmt->trigger.forward_ports, fp_min_reg);
+			netlink_put_register(nle, NFTNL_EXPR_TRIGGER_FPORTS_MIN,
+							fp_min_reg);
+		}
+	}
+
+	while (registers > 0) {
+		release_register(ctx, NULL);
+		registers--;
+	}
+
+	nft_rule_add_expr(ctx, nle, &stmt->location);
+}
+
 static void netlink_gen_tproxy_stmt(struct netlink_linearize_ctx *ctx,
 				 const struct stmt *stmt)
