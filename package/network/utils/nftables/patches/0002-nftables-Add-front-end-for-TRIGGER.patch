+			}
+			| FORWARD_PROTO TCP close_scope_tcp
+			{
+				$<stmt>0->trigger.forward_proto = IPPROTO_TCP;
+			}
+			| FORWARD_PROTO UDP close_scope_udp
+			{
+				$<stmt>0->trigger.forward_proto = IPPROTO_UDP;
+			}
+			| FORWARD_PROTO ALL
+			{
+				$<stmt>0->trigger.forward_proto = 0;
+			}
+			| TRIGGER_TIMER NUM
+			{
+				$<stmt>0->trigger.timer = $2;
+			}
+			| TRIGGER_PORTS stmt_expr
+			{
+				$<stmt>0->trigger.trigger_ports = $2;
+			}
+			| FORWARD_PORTS stmt_expr
+			{
+				$<stmt>0->trigger.forward_ports = $2;
+			}
+			;
+
 masq_stmt		:	masq_stmt_alloc		masq_stmt_args
 			|	masq_stmt_alloc
 			;
